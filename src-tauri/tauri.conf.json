{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bookiin",
  "version": "1.0.0",
  "identifier": "com.tomikav.bookiin",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bookiin",
        "width": 1240,
        "height": 820,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "theme": "Dark",
        "backgroundColor": "#0b0a0f",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self'; worker-src 'self' blob:; connect-src 'self' blob: data: ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "Tomika",
    "copyright": "Tomika",
    "category": "Productivity",
    "shortDescription": "Lector de libros, manga y webtoons",
    "longDescription": "Bookiin es un lector de escritorio minimalista para PDFs, CBZ y carpetas de imagenes. Todo se guarda localmente.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Spanish"
        ],
        "installMode": "currentUser"
      },
      "wix": {
        "language": "es-ES"
      }
    }
  }
}
